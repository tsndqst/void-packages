# Template file for 'nanopct6-uboot'
pkgname=nanopct6-uboot
version=2026.07
revision=1
archs="aarch64*"
hostmakedepends="bison flex bc dtc which python3 swig python3-devel python3-setuptools python3-pyelftools openssl-devel libuuid-devel gnutls-devel ncurses-libtinfo-devel"
makedepends="atf-rk3588-bl31"
depends="u-boot-tools mtd-utils"
short_desc="Das U-Boot for the RockPro64 SBC"
maintainer="Tim Sandquist <tim.sandquist@gmail.com>"
license="GPL-2.0-or-later, BSD-3-Clause"
homepage="https://www.denx.de/wiki/U-Boot/"
_rkbin_ddr_version=1.19
distfiles="https://ftp.denx.de/pub/u-boot/u-boot-${version}.tar.bz2 https://github.com/rockchip-linux/rkbin/raw/master/bin/rk35/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v${_rkbin_ddr_version}.bin"
checksum="78e8bfc382fe388f9b55aa1daf8c563522a037779b5d4c349d1415e381f1243e
 e109f3e283c86ad74b6574f5538b11750dea4cab7668175717aa2af7994c28ef"
skip_extraction="rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v${_rkbin_ddr_version}.bin"

do_configure() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	make ${makejobs} nanopc-t6-rk3588_defconfig
}

do_build() {
	unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
	if [ "$CROSS_BUILD" ]; then
		export CROSS_COMPILE=${XBPS_CROSS_TRIPLET}-
	fi
	make ${makejobs} EXTRAVERSION=-${revision} \
		BL31=${XBPS_CROSS_BASE}/usr/lib/trusted-firmware-a/rk3588/bl31.elf \
		ROCKCHIP_TPL=${XBPS_SRCDISTDIR}/${pkgname}-${version}/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v${_rkbin_ddr_version}.bin
}

do_install() {
	vinstall idbloader.img 0644 usr/lib/nanopct6-uboot
	vinstall u-boot.itb 0644 usr/lib/nanopct6-uboot
	vinstall u-boot-rockchip-spi.bin 0644 usr/lib/nanopct6-uboot
	vinstall u-boot-rockchip.bin 0644 usr/lib/nanopct6-uboot
	vdoc "${FILESDIR}/README.voidlinux"
	vlicense Licenses/Exceptions
	vlicense Licenses/README
	vlicense Licenses/bsd-2-clause.txt
	vlicense Licenses/bsd-3-clause.txt
	vlicense Licenses/eCos-2.0.txt
	vlicense Licenses/ibm-pibs.txt
	vlicense Licenses/isc.txt
	vlicense Licenses/r8a779x_usb3.txt
	vlicense Licenses/x11.txt
}
